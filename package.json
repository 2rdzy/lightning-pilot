{
  "name": "lightning-pilot",
  "private": true,
  "description": "Lightning node manager for Bitcoin (Blake2b and SHA256d)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel exec tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "licenses:check": "node tools/check-licenses.mjs",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm licenses:check",
    "test:regtest": "vitest run --config vitest.regtest.config.ts",
    "test:better-sqlite3": "TEST_SQLITE_DRIVER=better-sqlite3 vitest run apps/server",
    "test:coverage": "vitest run --coverage",
    "dev:server": "node tools/dev/server.ts",
    "dev:web": "pnpm --filter @lightning-pilot/web dev",
    "build:web": "pnpm --filter @lightning-pilot/web build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "better-sqlite3": "13.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
